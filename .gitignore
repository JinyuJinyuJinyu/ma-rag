# Datasets: licence-restricted files that must never be published
# (see each dataset's README.md and MANIFEST.md). `**/` matches at any depth, so the
# patterns also cover the kits in datasets/archive/
datasets/**/raw/
datasets/**/full/
datasets/**/uhc-finance-lens/*_clean.xlsx
datasets/**/dhl-earnings-desk/*_clean.xlsx

# ai-earnings-desk: the SEC and IR downloads in the company folders and the cleaned MSFT copy in
# prepared/ stay out (IR files are company-copyrighted). Our own files are tracked: the plan, the
# selection and index CSVs, the manifests and READMEs, the scripts and the comparison workbook
datasets/ai-earnings-desk/**
!datasets/ai-earnings-desk/**/
!datasets/ai-earnings-desk/*.md
!datasets/ai-earnings-desk/*.csv
!datasets/ai-earnings-desk/*/MANIFEST.md
!datasets/ai-earnings-desk/*/README.md
!datasets/ai-earnings-desk/scripts/*.py
!datasets/ai-earnings-desk/comparison/*
